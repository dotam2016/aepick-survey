# Copy to .env.local for `vercel dev`, and set the same values in
# Vercel dashboard -> Project Settings -> Environment Variables for the
# deployed version. Same Supabase project as the main kiosk server.

SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Shared secret the Zalo QR/mini-app team puts in the "x-webhook-secret"
# header when they POST to /api/webhooks/zalo-checkin.
ZALO_WEBHOOK_SECRET=

# Key required in the "x-admin-key" header to call GET /api/admin/registrations.
ADMIN_KEY=
