# Copy this file to .env and fill in your own Supabase project's values.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Transaction pooler" (port 6543) connection string.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Shared secret the Zalo QR/mini-app team puts in the "x-webhook-secret" header
# when they POST to /api/webhooks/zalo-checkin. Set this and share the value
# with them before going live — falls back to a fixed dev-only default otherwise.
ZALO_WEBHOOK_SECRET=
